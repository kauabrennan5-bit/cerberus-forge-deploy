# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password for backend product creation and deletion
ADMIN_PASSWORD=""

# META_PIXEL_ID & META_ACCESS_TOKEN: Meta Conversions API (CAPI)
META_PIXEL_ID=""
META_ACCESS_TOKEN=""

# TELEGRAM_BOT_TOKEN & TELEGRAM_ALLOWED_USER_IDS: Telegram Bot Integration (Fase 4.1)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USER_IDS=""
TELEGRAM_ALLOWED_USERS=""
# Opcional, porém recomendado: deve ser definido no Render e reutilizado ao registrar o webhook.
TELEGRAM_WEBHOOK_SECRET=""

# SUPABASE_URL, SUPABASE_KEY & SUPABASE_SERVICE_ROLE_KEY: Persistent PostgreSQL Database (Supabase)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Newsletter outbox worker e provider Brevo — somente servidor; nunca versionar valores reais
NEWSLETTER_OUTBOX_WORKER_ENABLED="false"
NEWSLETTER_OUTBOX_POLL_INTERVAL_MS="30000"
BREVO_API_KEY=""
NEWSLETTER_SENDER_EMAIL=""
NEWSLETTER_SENDER_NAME="Cerberus Finds"
NEWSLETTER_SUBJECT="Sua inscrição no Cerberus Finds foi confirmada"
NEWSLETTER_PROVIDER_TIMEOUT_MS="15000"

# Sincronização do catálogo e validação operacional (somente servidor)
GITHUB_TOKEN=""
CATALOG_API_URL="https://cerberus-forge-deploy-backend.onrender.com/api/products"
STATIC_CATALOG_URL="https://cerberus-static-catalog.onrender.com"
PUBLIC_SITE_URL="https://cerberusfinds.com"

# Google Analytics Data API (somente servidor)
GA4_PROPERTY_ID=""
GA_SERVICE_ACCOUNT_JSON=""

# GOOGLE ANALYTICS 4 (GA4) MEASUREMENT ID
VITE_GA4_MEASUREMENT_ID=""

# Bloco 7.5 — limites e orçamento do backend (sem secrets)
ADMIN_RATE_LIMIT_PER_MINUTE="30"
CATALOG_RATE_LIMIT_PER_MINUTE="120"
ANALYTICS_RATE_LIMIT_PER_MINUTE="30"
EXPENSIVE_RATE_LIMIT_PER_MINUTE="10"
GEMINI_HOURLY_BUDGET="20"
RENDER_GIT_COMMIT=""

# GitHub Actions Watchdog — configurar como GitHub Actions Secrets, nunca no arquivo
# CERBERUS_HEALTH_URL="https://cerberus-forge-deploy-backend.onrender.com/health"
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_ADMIN_CHAT_ID=""
# WATCHDOG_TIMEOUT_MS="10000"
# WATCHDOG_STATE_PATH="state/watchdog-state.json"

# Supabase: aplicar supabase/migrations/20260814_operator_state.sql antes de habilitar auto-heal.
# O backend entra em OBSERVE/SAFE_MODE se operator_state não puder ser lido ou persistido.

# O watchdog envia alerta somente em transições HEALTHY -> DOWN e DOWN -> HEALTHY.
# Não criar segredos automaticamente e não versionar valores reais neste arquivo.
