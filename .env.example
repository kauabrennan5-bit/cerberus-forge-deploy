# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAI is optional at runtime because Curator semantic discovery fails over to Gemini.
OPENAI_API_KEY=""

APP_URL="MY_APP_URL"
ADMIN_PASSWORD=""
META_PIXEL_ID=""
META_ACCESS_TOKEN=""

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USER_IDS=""
TELEGRAM_ALLOWED_USERS=""
TELEGRAM_WEBHOOK_SECRET=""

# Supabase persistent PostgreSQL database
SUPABASE_URL="https://juiychcfdqxgnatffnla.supabase.co"
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Newsletter/Brevo — server only; real send remains disabled by default.
NEWSLETTER_OUTBOX_WORKER_ENABLED="false"
NEWSLETTER_OUTBOX_POLL_INTERVAL_MS="30000"
BREVO_API_KEY=""
NEWSLETTER_SENDER_EMAIL=""
NEWSLETTER_SENDER_NAME="Cerberus Finds"
NEWSLETTER_SUBJECT="Sua inscrição no Cerberus Finds foi confirmada"
NEWSLETTER_PROVIDER_TIMEOUT_MS="15000"
DRY_RUN="true"
BREVO_BATCH_SIZE="1"
BREVO_BATCH_DELAY_MS="0"
NEWSLETTER_CAMPAIGN_LEASE_MS="60000"
NEWSLETTER_CAMPAIGN_MAX_ATTEMPTS="3"
NEWSLETTER_PUBLIC_BASE_URL=""
NEWSLETTER_CAMPAIGN_SUBJECT=""
NEWSLETTER_TEST_EMAIL=""
NEWSLETTER_CAMPAIGN_WORKER_ENABLED="false"
NEWSLETTER_CAMPAIGN_POLL_INTERVAL_MS="30000"
TELEGRAM_ADMIN_CHAT_ID=""

# Canonical production architecture:
# public.products (Supabase) -> Supabase Edge -> cerberus-design-static.
PUBLIC_SITE_URL="https://cerberus-design-static.onrender.com"
PUBLIC_STOREFRONT_URL="https://cerberus-design-static.onrender.com"
PUBLIC_CATALOG_URL="https://juiychcfdqxgnatffnla.supabase.co/functions/v1/cerberus-public-api/products"
PUBLIC_CATALOG_API_URL="https://juiychcfdqxgnatffnla.supabase.co/functions/v1/cerberus-public-api/products"
PUBLIC_BACKEND_URL="https://cerberus-forge-deploy-backend.onrender.com"
GITHUB_TOKEN=""

# Google Analytics Data API (server only)
GA4_PROPERTY_ID=""
GA_SERVICE_ACCOUNT_JSON=""
VITE_GA4_MEASUREMENT_ID=""

# Backend operational limits/budgets
ADMIN_RATE_LIMIT_PER_MINUTE="30"
CATALOG_RATE_LIMIT_PER_MINUTE="120"
ANALYTICS_RATE_LIMIT_PER_MINUTE="30"
EXPENSIVE_RATE_LIMIT_PER_MINUTE="10"
GEMINI_HOURLY_BUDGET="20"
OPENAI_AUTONOMOUS_DISCOVERY_HOURLY_BUDGET="72"
GEMINI_AUTONOMOUS_DISCOVERY_HOURLY_BUDGET="72"
RENDER_GIT_COMMIT=""

# Curator category invariant/recovery. Production values must be set deliberately.
AUTONOMOUS_CURATOR_DAILY_TARGET_PER_CATEGORY="5"
AUTONOMOUS_CURATOR_RECOVERY_MODE="true"
AUTONOMOUS_CURATOR_DEFICIT_CATEGORIES=""

# GitHub Actions Watchdog — configure as Actions Secrets, never commit real values.
# CERBERUS_HEALTH_URL="https://cerberus-forge-deploy-backend.onrender.com/health"
# WATCHDOG_TIMEOUT_MS="10000"
# WATCHDOG_STATE_PATH="state/watchdog-state.json"

# The watchdog alerts only on HEALTHY -> DOWN and DOWN -> HEALTHY transitions.
# Never create or commit real secrets in this file.
