# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password for backend administrative operations.
# Production recommendation: use a long unique value and rotate immediately after any exposure.
ADMIN_PASSWORD=""

# META_PIXEL_ID & META_ACCESS_TOKEN: Meta Conversions API (CAPI), SERVER ONLY.
# Never expose META_ACCESS_TOKEN to VITE_* variables or browser configuration.
META_PIXEL_ID=""
META_ACCESS_TOKEN=""

# Browser CORS allowlist. PUBLIC_SITE_URL / STATIC_CATALOG_URL / APP_URL are also allowed.
# Comma-separated origins, no paths. Example: https://preview.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=""

# Diagnostic routes are disabled by default. When explicitly enabled, a separate token is mandatory.
DIAGNOSTICS_ENABLED="false"
DIAGNOSTICS_TOKEN=""

# TELEGRAM_BOT_TOKEN & TELEGRAM_ALLOWED_USER_IDS: Telegram Bot Integration.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USER_IDS=""
TELEGRAM_ALLOWED_USERS=""
# REQUIRED for webhook mode. The backend refuses webhook registration/processing without it.
TELEGRAM_WEBHOOK_SECRET=""

# SUPABASE_URL, SUPABASE_KEY & SUPABASE_SERVICE_ROLE_KEY: Persistent PostgreSQL Database
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Operator scheduler is fail-closed until Supabase persistence has been validated.
OPERATOR_SCHEDULER_ENABLED="false"

# Newsletter outbox worker e provider Brevo — somente servidor; nunca versionar valores reais
NEWSLETTER_OUTBOX_WORKER_ENABLED="false"
NEWSLETTER_OUTBOX_POLL_INTERVAL_MS="30000"
BREVO_API_KEY=""
NEWSLETTER_SENDER_EMAIL=""
NEWSLETTER_SENDER_NAME="Cerberus Finds"
NEWSLETTER_SUBJECT="Sua inscrição no Cerberus Finds foi confirmada"
NEWSLETTER_PROVIDER_TIMEOUT_MS="15000"
# Campaigns: keep real sending disabled until migrations and human review are authorized.
DRY_RUN="true"
BREVO_BATCH_SIZE="1"
BREVO_BATCH_DELAY_MS="0"
NEWSLETTER_CAMPAIGN_LEASE_MS="60000"
NEWSLETTER_CAMPAIGN_MAX_ATTEMPTS="3"
NEWSLETTER_PUBLIC_BASE_URL=""
NEWSLETTER_CAMPAIGN_SUBJECT=""
NEWSLETTER_TEST_EMAIL=""
NEWSLETTER_CAMPAIGN_WORKER_ENABLED="false"
NEWSLETTER_CAMPAIGN_POLL_INTERVAL_MS="30000"
TELEGRAM_ADMIN_CHAT_ID=""

# Sincronização do catálogo e validação operacional (somente servidor)
GITHUB_TOKEN=""
CATALOG_API_URL="https://cerberus-forge-deploy-backend.onrender.com/api/products"
STATIC_CATALOG_URL="https://cerberus-static-catalog.onrender.com"
PUBLIC_SITE_URL="https://cerberusfinds.com"

# Google Analytics Data API (somente servidor)
GA4_PROPERTY_ID=""
GA_SERVICE_ACCOUNT_JSON=""

# Public GA4 measurement ID. Loading remains gated by explicit analytics consent in the browser.
VITE_GA4_MEASUREMENT_ID=""

# Bloco 7.5 — limites e orçamento do backend (sem secrets)
ADMIN_RATE_LIMIT_PER_MINUTE="30"
CATALOG_RATE_LIMIT_PER_MINUTE="120"
ANALYTICS_RATE_LIMIT_PER_MINUTE="30"
NEWSLETTER_RATE_LIMIT_PER_MINUTE="10"
EXPENSIVE_RATE_LIMIT_PER_MINUTE="10"
GEMINI_HOURLY_BUDGET="20"
RENDER_GIT_COMMIT=""

# GitHub Actions Watchdog — configurar como GitHub Actions Secrets, nunca no arquivo
# CERBERUS_HEALTH_URL="https://cerberus-forge-deploy-backend.onrender.com/health"
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_ADMIN_CHAT_ID=""
# WATCHDOG_TIMEOUT_MS="10000"
# WATCHDOG_STATE_PATH="state/watchdog-state.json"

# Supabase: aplicar as migrations reproduzíveis antes de habilitar auto-heal/operator scheduler.
# O backend deve permanecer em OBSERVE/SAFE_MODE enquanto operator_state não puder ser lido/persistido.

# Nunca criar segredos automaticamente e nunca versionar valores reais neste arquivo.
