{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/build-by-target.mjs",
    "build:full": "node --import tsx scripts/generate-static-catalog.js && vite build && node --import tsx scripts/generate-product-og-pages.js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:backend": "node --import tsx scripts/generate-static-catalog.js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx/esm --test --test-concurrency=1 --test-reporter=spec tests/*.test.ts"
  },
  "dependencies": {
    "@google-analytics/data": "^7.0.0",
    "@google/genai": "^2.18.0",
    "@octokit/rest": "^22.0.1",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "three": "^0.185.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2"
  }
}
